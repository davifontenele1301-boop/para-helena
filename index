<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>para helena :D</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Quicksand',sans-serif;
    color:white;
    text-align:center;

    background:linear-gradient(135deg,#2d003d,#5a189a,#9d4edd,#c77dff);
    background-size:400% 400%;
    animation:fundo 12s ease infinite;

    min-height:100vh;
    overflow:hidden;
}

/* Fundo animado */
@keyframes fundo{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
}

.caixa{
    margin:100px auto;
    width:700px;
    max-width:90%;
    padding:40px;

    background:rgba(255,255,255,.08);
    backdrop-filter:blur(12px);

    border:2px solid #ffb3ff;
    border-radius:25px;

    box-shadow:
    0 0 20px #c77dff,
    0 0 50px #9d4edd;
}

h1{
    font-size:45px;
    color:#ffd6ff;
    text-shadow:0 0 15px #ff9ff3;
}

p{
    margin-top:15px;
    font-size:20px;
}

/* GIF superior esquerdo */
.gif1{
    position:fixed;
    top:20px;
    left:20px;
    width:180px;
    animation:flutuar 3s ease-in-out infinite;
}

/* GIF superior direito */
.gif2{
    position:fixed;
    top:20px;
    right:20px;
    width:180px;
    animation:flutuar 4s ease-in-out infinite;
}

/* GIF inferior */
.gif3{
    position:fixed;
    bottom:15px;
    left:50%;
    transform:translateX(-50%);
    width:200px;
    animation:flutuar 2.8s ease-in-out infinite;
}

@keyframes flutuar{
    0%{
        transform:translateY(0px);
    }
    50%{
        transform:translateY(-12px);
    }
    100%{
        transform:translateY(0px);
    }
}

.estrelinhas{
    position:fixed;
    inset:0;
    pointer-events:none;
    background-image:
        radial-gradient(#ffffff88 1px, transparent 1px);
    background-size:40px 40px;
    animation:estrela 20s linear infinite;
}

@keyframes estrela{
    from{
        background-position:0 0;
    }
    to{
        background-position:0 800px;
    }
}
</style>

</head>
<body>

<div class="estrelinhas"></div>

<!-- Troque pelos GIFs da Hello Kitty que você quiser -->
<img class="gif1" src="https://i.pinimg.com/originals/57/cb/84/57cb840f3a58b99b28953e676c343d7b.gif" alt="Hello Kitty">
<img class="gif2" src="https://i.pinimg.com/originals/57/cb/84/57cb840f3a58b99b28953e676c343d7b.gif" alt="Hello Kitty">
<img class="gif3" src="https://i.pinimg.com/originals/57/cb/84/57cb840f3a58b99b28953e676c343d7b.gif" alt="Hello Kitty">

<div class="caixa">
    <h1>💜 Para Helena 💜</h1>
    <p>Você é a melhor parte dos meus dias. ✨</p>
    <p>Aperte <b>F12</b> e abra o <b>Console</b> para uma surpresa! 🩷</p>
</div>

<script>
document.write("");

const oquantoeuteamo = [
    "eu te amo",
    "eu te amo muito",
    "eu te amo demais",
    "eu te amo mais que tudo",
    "eu te amo mais que ontem e menos que amanhã"
];

console.log("💜 Para Helena 💜");
console.log("-------------------------");

oquantoeuteamo.forEach(frase => {
    console.log("💕 " + frase);
});
</script>

</body>
</html>
